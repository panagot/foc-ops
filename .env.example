# Copy to .env.local (gitignored) for local FOC / Calibration testing
FOC_DEMO_NETWORK=calibration
FOC_CALIBRATION_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Demo console + CLI default Pay address (public is fine)
FOC_DEMO_ADDRESS=0xYourCalibrationAddress

# Deploy TierRegistry / on-chain writes only (NEVER commit)
# FOC_PRIVATE_KEY=0x…

# After deploy:
# FOC_TIER_REGISTRY_CALIBRATION=0x…
